
config samba
	option workgroup 'WORKGROUP'
	option charset 'UTF-8'
	option description 'Samba on OpenWRT'
	option name 'N1'
	option homes '0'
	option macos '0'

config sambashare
	option name '移动硬盘'
	option path '/mnt/sdb1'
	option read_only 'no'
	option force_root '1'
	option users 'root'
	option create_mask '0777'
	option dir_mask '0777'

